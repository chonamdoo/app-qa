# Jev (TypeSafe System One). Set ONE of these. Never commit real values.
TYPESAFE_API_KEY=
# Absolute path to a file whose only content is the key (file mode must be 0600).
TYPESAFE_API_KEY_FILE=
# Optional overrides
# TYPESAFE_BASE_URL=https://api.typesafe.ai/v1
# QA_JEV_MODEL=jev-1.13.0

# Android SDK root (adb/emulator are not required on PATH)
ANDROID_HOME=~/Library/Android/sdk

# Document → test generation LLM: claude-cli | codex-cli
QA_LLM=claude-cli
# QA_LLM_MODEL=claude-opus-5-5

# App secrets referenced by tests as ${NAME} go here too.
