{
  "name": "qautra",
  "version": "0.1.0",
  "private": true,
  "description": "QAutra: app-agnostic Android/iOS and web QA automation with Appium execution, typed decisions, and fail-closed verdicts.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "qa": "bin/qa.ts"
  },
  "scripts": {
    "qa": "node bin/qa.ts",
    "test": "node --test --test-reporter=spec \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "appium": "3.8.0",
    "exceljs": "4.4.0",
    "json-logic-js": "2.0.5",
    "mammoth": "1.12.3",
    "unpdf": "1.8.1",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "typescript": "7.0.2"
  }
}
